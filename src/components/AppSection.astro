---
import '../styles/app-section.css';

interface Props {
  variant?: 'default' | 'card';
  class?: string;
  id?: string;
  ariaLabelledby?: string;
  ariaLabel?: string;
  hidden?: boolean;
}

const {
  variant = 'default',
  class: className,
  id,
  ariaLabelledby,
  ariaLabel,
  hidden = false,
} = Astro.props;

const classes = ['app-section', `app-section--${variant}`, className]
  .filter(Boolean)
  .join(' ');
---

<section
  class={classes}
  id={id}
  aria-labelledby={ariaLabelledby}
  aria-label={ariaLabel}
  hidden={hidden}
>
  <slot />
</section>
