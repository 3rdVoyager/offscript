---
import '../styles/app-sidebar.css';
import '../styles/icons.css';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string, includeChildren = false): boolean => {
  const normalizedPath = path.replace(/\/$/, '') || '/';
  return (
    currentPath === normalizedPath ||
    (includeChildren && currentPath.startsWith(`${normalizedPath}/`))
  );
};

const dashboard = {
  label: 'Dashboard',
  href: '/app/',
  icon: 'home',
};

const sections = [
  {
    label: 'Script',
    links: [
      { label: 'Overview', href: '/app/script/overview/', icon: 'book' },
      { label: 'View', href: '/app/script/view/', icon: 'description' },
      { label: 'Progress', href: '/app/script/progress/', icon: 'trending_up' },
    ],
  },
  {
    label: 'Practice',
    links: [
      { label: 'Type', href: '/app/practice/type/', icon: 'keyboard' },
    ],
  },
  {
    label: 'Manage',
    className: 'app-sidebar-bottom',
    links: [
      { label: 'Scripts', href: '/app/manage/scripts/', icon: 'library_books' },
      { label: 'Settings', href: '/app/manage/settings/', icon: 'settings' },
    ],
  },
];
---

<aside class="app-sidebar">
  <a href="/app/" class="app-sidebar-brand">
    <img
      src="/assets/brand/favicon/web-app-manifest-512x512.png"
      alt=""
      width="40"
      height="40"
    />
    <span>OffScript!</span>
  </a>

  <nav class="app-sidebar-nav">
    <ul>
      <li>
        <a href={dashboard.href} aria-current={isCurrent('/app') ? 'page' : undefined}>
          <span class="material-icons nav-link-icon" aria-hidden="true">{dashboard.icon}</span>
          <span class="nav-link-label">{dashboard.label}</span>
        </a>
      </li>
    </ul>
  </nav>

  {
    sections.map((section) => (
      <nav
        class:list={['app-sidebar-nav', section.className]}
        aria-label={section.label}
      >
        <p class="app-sidebar-section-label">{section.label}</p>
        <ul>
          {section.links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href, true) ? 'page' : undefined}
              >
                <span class="material-icons nav-link-icon" aria-hidden="true">{link.icon}</span>
                <span class="nav-link-label">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
  }
</aside>
