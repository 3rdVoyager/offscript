---
import '../styles/toasts.css';
---

<div class="toasts" data-toasts aria-live="polite" aria-atomic="false"></div>

<script>
  import { consumePendingToast, showToast } from '../scripts/toasts';

  const pendingToast = consumePendingToast();
  if (pendingToast) {
    showToast(pendingToast.message, pendingToast.variant);
  }
</script>
