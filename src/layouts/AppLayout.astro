---
import BaseLayout from './BaseLayout.astro';
import AppSidebar from '../components/AppSidebar.astro';
import Toasts from '../components/Toasts.astro';
import '../styles/app.css';

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle} useMaterialIcons>
  <div class="app-shell">
    <AppSidebar />
    <main class="app-main">
      <slot />
    </main>
    <Toasts />
  </div>
</BaseLayout>