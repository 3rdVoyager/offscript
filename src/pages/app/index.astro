---
import AppLayout from "../../layouts/AppLayout.astro";
import AppSection from "../../components/AppSection.astro";
import EmptyState from "../../components/EmptyState.astro";

const hasScripts = false;
---

<AppLayout pageTitle="Dashboard">
  <AppSection class="app-page-header">
    <h1>Dashboard</h1>
    <p>Your home base for scripts, practice, and progress.</p>
  </AppSection>

  {
    hasScripts ? null : (
      <AppSection>
        <EmptyState
          title="Welcome to OffScript"
          description="Add a script to start practicing lines, tracking progress, and building confidence. Practice tools will appear here once you're ready."
          actionLabel="Add your first script"
          actionHref="/app/manage/scripts/add/"
        />
      </AppSection>
    )
  }
</AppLayout>
