---
import AppLayout from "../../layouts/AppLayout.astro";
import AppSection from "../../components/AppSection.astro";
import "../../styles/dashboard.css";

const hasScripts = false;
---

<AppLayout pageTitle="Dashboard">
  <AppSection class="app-page-header">
    <h1>Dashboard</h1>
    <p>Your home base for scripts, practice, and progress.</p>
  </AppSection>

  {
    hasScripts ? null : (
      <AppSection variant="card" class="new-user-welcome">
        <h2>Welcome to OffScript</h2>
        <p>Add a script to start practicing lines, tracking progress, and building confidence.</p>
        <a href="/app/manage/settings/" class="button">Add your first script</a>
      </AppSection>
    )
  }

  <AppSection>
    <h2>Practice tools</h2>
    <p>
      Coming soon!
    </p>
  </AppSection>
</AppLayout>
