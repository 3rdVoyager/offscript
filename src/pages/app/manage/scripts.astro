---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import TabBar from '../../../components/TabBar.astro';
import EmptyState from '../../../components/EmptyState.astro';
import '../../../styles/scripts.css';

const tabs = [
  { label: 'View scripts', href: '/app/manage/scripts/' },
  { label: 'Add script', href: '/app/manage/scripts/add/' },
];
---

<AppLayout pageTitle="Scripts">
  <AppSection class="app-page-header">
    <h1>Scripts</h1>
    <p>Keep your scripts in one place and choose what you want to practice.</p>
  </AppSection>

  <AppSection>
    <TabBar tabs={tabs} />
  </AppSection>

  <AppSection class="scripts-empty-section" ariaLabel="Saved scripts">
    <EmptyState
      title="No scripts yet"
      description="Add your first script to begin practicing."
      actionLabel="Add a script"
      actionHref="/app/manage/scripts/add/"
    />
  </AppSection>

  <AppSection
    variant="card"
    class="scripts-grid-section"
    ariaLabel="Saved script cards"
    hidden
  >
    <div class="scripts-grid" data-scripts-grid></div>
  </AppSection>
</AppLayout>

<script>
  import { deleteScript, getScriptStore, setActiveScript } from '../../../scripts/script-store';
  import { showToast } from '../../../scripts/toasts';

  const emptyState = document.querySelector('[data-empty-state]');
  const emptySection = document.querySelector('.scripts-empty-section');
  const scriptsGrid = document.querySelector('[data-scripts-grid]');
  const scriptsSection = document.querySelector('.scripts-grid-section');

  if (emptyState instanceof HTMLElement &&
      emptySection instanceof HTMLElement &&
      scriptsGrid instanceof HTMLElement &&
      scriptsSection instanceof HTMLElement) {
    const store = getScriptStore();
    const scripts = store.scripts;

    if (scripts.length > 0) {
      emptyState.hidden = true;
      emptySection.hidden = true;
      scriptsSection.hidden = false;

      for (const script of scripts) {
        scriptsGrid.appendChild(createScriptCard(script, store.activeScriptId));
      }
    }
  }

  scriptsGrid?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    if (event.target.closest('a')) {
      return;
    }

    const deleteButton = event.target.closest('[data-delete-script]');
    if (deleteButton instanceof HTMLButtonElement) {
      const scriptId = deleteButton.dataset.deleteScript;
      if (scriptId) {
        deleteSelectedScript(scriptId);
      }
      return;
    }

    const card = event.target.closest('.script-card');
    const scriptId = card?.getAttribute('data-script-id');
    if (scriptId) {
      selectScript(scriptId);
    }
  });

  scriptsGrid?.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent) ||
        !(event.target instanceof HTMLElement) ||
        !event.target.classList.contains('script-card') ||
        (event.key !== 'Enter' && event.key !== ' ')) {
      return;
    }

    event.preventDefault();
    const scriptId = event.target.getAttribute('data-script-id');
    if (scriptId) {
      selectScript(scriptId);
    }
  });

  function createScriptCard(script: any, activeScriptId: string | null): HTMLElement {
    const card = document.createElement('article');
    card.className = 'script-card';
    card.dataset.scriptId = script.id;
    card.setAttribute('role', 'button');
    card.tabIndex = 0;
    const isActive = script.id === activeScriptId;
    if (isActive) {
      card.classList.add('is-active');
    }
    card.setAttribute('aria-pressed', String(isActive));

    const title = document.createElement('h2');
    title.textContent = script.title || 'Untitled script';

    const details = document.createElement('p');
    details.className = 'script-card-details';
    details.textContent = `${script.acts?.length || 0} acts · ${countScenes(script)} scenes`;

    const actions = document.createElement('div');
    actions.className = 'script-card-actions';

    const selection = document.createElement('span');
    selection.className = 'script-card-selection';
    selection.textContent = isActive ? 'Selected script' : 'Click to select';

    const link = document.createElement('a');
    link.className = 'button-secondary';
    link.href = '/app/script/overview/';
    link.textContent = 'Open overview';

    const deleteButton = document.createElement('button');
    deleteButton.type = 'button';
    deleteButton.className = 'button-danger script-card-delete';
    deleteButton.dataset.deleteScript = script.id;
    deleteButton.setAttribute('aria-label', `Delete ${script.title || 'script'}`);
    deleteButton.innerHTML = '<span class="material-icons" aria-hidden="true">delete</span>';

    actions.append(selection, link, deleteButton);
    card.append(title, details, actions);
    return card;
  }

  function deleteSelectedScript(scriptId: string): void {
    const store = getScriptStore();
    const script = store.scripts.find((item) => item.id === scriptId);
    if (!script || !window.confirm(`Delete "${script.title || 'Untitled script'}"?`)) {
      return;
    }

    if (!deleteScript(scriptId)) {
      return;
    }

    sessionStorage.setItem(
      'offscript-pending-toast',
      JSON.stringify({
        message: `"${script.title || 'Untitled script'}" was deleted.`,
        variant: 'success',
      }),
    );
    window.location.reload();
  }

  function selectScript(scriptId: string): void {
    if (!setActiveScript(scriptId)) {
      return;
    }

    const store = getScriptStore();

    document.querySelectorAll('.script-card').forEach((card) => {
      const isSelected = card.getAttribute('data-script-id') === scriptId;
      card.classList.toggle('is-active', isSelected);
      card.setAttribute('aria-pressed', String(isSelected));
      const selection = card.querySelector('.script-card-selection');
      if (selection) {
        selection.textContent = isSelected ? 'Selected script' : 'Click to select';
      }
    });

    const selected = store.scripts.find((script) => script.id === scriptId);
    showToast(`"${selected?.title || 'Script'}" is now selected.`);
  }

  function countScenes(script: any): number {
    if (!Array.isArray(script.acts)) {
      return 0;
    }

    return script.acts.reduce(
      (total: number, act: any) =>
        total + (Array.isArray(act.scenes) ? act.scenes.length : 0),
      0,
    );
  }
</script>
