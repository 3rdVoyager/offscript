---
import AppLayout from '../../../../layouts/AppLayout.astro';
import AppSection from '../../../../components/AppSection.astro';
import AppPageHeader from '../../../../components/AppPageHeader.astro';
import TabBar from '../../../../components/TabBar.astro';
import AddScriptForm from '../../../../components/AddScriptForm.astro';
import '../../../../styles/add-script.css';

const tabs = [
  { label: 'View scripts', href: '/app/manage/scripts/' },
  { label: 'Add script', href: '/app/manage/scripts/add/' },
];
---

<AppLayout pageTitle="Add Script">
  <AppPageHeader
    title="Add script"
    description="Save a script or study document to start practicing."
  />

  <AppSection>
    <TabBar tabs={tabs} />
  </AppSection>

  <AppSection variant="card">
    <AddScriptForm />
  </AppSection>

  <AppSection ariaLabel="Example scripts">
    <h2>Example scripts</h2>
    <p>Load one of these examples into the importer to try the app.</p>

    <div class="example-grid">
      <article class="example-card">
        <h3>The Two Noble Kinsmen</h3>
        <p>HST Shakespeare Troupe 2025-2026 script for The Two Noble Kinsmen.</p>
        <button
          type="button"
          class="button-secondary"
          data-load-example="/example-scripts/two-noble-kinsmen.json"
        >
          Load example
        </button>
      </article>

      <article class="example-card">
        <h3>Little Women</h3>
        <p>HST Shakespeare Troupe 2026-2027 script for Little Women.</p>
        <button
          type="button"
          class="button-secondary"
          data-load-example="/example-scripts/little-women-offscript.json"
        >
          Load example
        </button>
      </article>
    </div>
  </AppSection>
</AppLayout>

<script>
  document.querySelectorAll('[data-load-example]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      const examplePath = button.dataset.loadExample;

      if (!examplePath) {
        return;
      }

      document.dispatchEvent(
        new CustomEvent('load-example', { detail: examplePath }),
      );
      document.querySelector('#add-script-form')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    });
  });
</script>
