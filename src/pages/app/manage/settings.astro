---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import TabBar from '../../../components/TabBar.astro';
import EmptyState from '../../../components/EmptyState.astro';

const tabs = [
  { label: 'Practice settings', href: '/app/manage/settings/' },
  { label: 'App settings', href: '/app/manage/settings/app/' },
];
---

<AppLayout pageTitle="Settings">
  <AppSection class="app-page-header">
    <h1>Settings</h1>
    <p>Configure practice and app options for your active script.</p>
  </AppSection>

  <AppSection>
    <TabBar tabs={tabs} />
  </AppSection>

  <AppSection ariaLabelledby="practice-heading">
    <AppSection variant="card">
      <EmptyState
        title="No practice settings yet"
        description="Practice options will become available after you add and select a script."
      />
    </AppSection>
  </AppSection>

</AppLayout>
