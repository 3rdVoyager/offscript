---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import TabBar from '../../../components/TabBar.astro';

const tabs = [
  { label: 'Practice settings', href: '/app/manage/settings/' },
  { label: 'App settings', href: '/app/manage/settings/app/' },
];
---

<AppLayout pageTitle="Settings">
  <AppSection class="app-page-header">
    <h1>Settings</h1>
    <p>Configure practice and app options for your active script.</p>
  </AppSection>

  <AppSection>
    <TabBar tabs={tabs} />
  </AppSection>

  <AppSection ariaLabelledby="practice-heading">
    <h2 id="practice-heading">Practice settings</h2>
    <AppSection variant="card">
      <form class="app-form">
        <fieldset>
          <legend>Practice with</legend>
          <label><input type="checkbox" name="characters" /> Characters</label>
          <label><input type="checkbox" name="scenes" /> Scenes</label>
        </fieldset>
        <p class="settings-note">Practice options will become available after a script is saved.</p>
      </form>
    </AppSection>
  </AppSection>

</AppLayout>
