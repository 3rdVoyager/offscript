---
import AppLayout from '../../../../layouts/AppLayout.astro';
import AppSection from '../../../../components/AppSection.astro';
import AppPageHeader from '../../../../components/AppPageHeader.astro';
import TabBar from '../../../../components/TabBar.astro';
import EmptyState from '../../../../components/EmptyState.astro';

const tabs = [
  { label: 'Practice settings', href: '/app/manage/settings/' },
  { label: 'App settings', href: '/app/manage/settings/app/' },
];
---

<AppLayout pageTitle="App Settings">
  <AppPageHeader
    title="Settings"
    description="Configure practice and app options for your active script."
  />

  <AppSection>
    <TabBar tabs={tabs} />
  </AppSection>

  <AppSection ariaLabelledby="app-settings-heading">
    <AppSection variant="card">
      <EmptyState
        title="No app settings yet"
        description="More app preferences will be added here."
      />
    </AppSection>
  </AppSection>
</AppLayout>
