---
import AppLayout from '../../../../layouts/AppLayout.astro';
import AppSection from '../../../../components/AppSection.astro';
import TabBar from '../../../../components/TabBar.astro';

const tabs = [
  { label: 'Practice settings', href: '/app/manage/settings/' },
  { label: 'App settings', href: '/app/manage/settings/app/' },
];
---

<AppLayout pageTitle="App Settings">
  <AppSection class="app-page-header">
    <h1>Settings</h1>
    <p>Configure practice and app options for your active script.</p>
  </AppSection>

  <AppSection>
    <TabBar tabs={tabs} />
  </AppSection>

  <AppSection ariaLabelledby="app-settings-heading">
    <h2 id="app-settings-heading">App settings</h2>
    <AppSection variant="card">
      <p class="settings-note">More app preferences will be added here.</p>
    </AppSection>
  </AppSection>
</AppLayout>
