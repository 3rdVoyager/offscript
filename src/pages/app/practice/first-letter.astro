---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import EmptyState from '../../../components/EmptyState.astro';
---

<AppLayout pageTitle="First Letter">
  <AppSection class="app-page-header">
    <h1>First Letter</h1>
    <p>Use the first letter of each word as a prompt for recall.</p>
  </AppSection>

  <AppSection>
    <AppSection variant="card">
      <EmptyState
        title="First Letter practice coming soon"
        description="Add a script and choose your practice settings to begin."
      />
    </AppSection>
  </AppSection>
</AppLayout>
