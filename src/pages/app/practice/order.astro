---
import AppLayout from "../../../layouts/AppLayout.astro";
import AppSection from "../../../components/AppSection.astro";
import AppPageHeader from "../../../components/AppPageHeader.astro";
import EmptyState from "../../../components/EmptyState.astro";
---

<AppLayout pageTitle="Order">
  <AppPageHeader
    title="Order"
    description="Use the arrows to put these lines back in their original order. Each set includes dialogue from your selected practice characters."
  />

  <AppSection class="order-empty-section is-loading" ariaLabel="Order practice empty state">
    <AppSection variant="card">
      <EmptyState
        title="No script selected"
        description="Select a script to begin ordering lines."
        actionLabel="Choose a script"
        actionHref="/app/manage/scripts/"
      />
    </AppSection>
  </AppSection>

  <div class="order-content" data-order-content hidden>
    <AppSection variant="card" class="order-tool" ariaLabel="Order practice">
      <div class="order-lines" data-order-lines></div>
      <div class="order-actions">
        <button type="button" class="button" data-check-order>Check</button>
      </div>
    </AppSection>
  </div>
</AppLayout>

<script>
  import { initializeActiveScriptPage } from "../../../scripts/active-script-page";
  import { getAllLines, type PracticeLine } from "../../../scripts/practice";
  import {
    getPracticeSettings,
    getSceneKey,
  } from "../../../scripts/practice-settings";
  import { showToast } from "../../../scripts/toasts";

  const script = initializeActiveScriptPage({
    emptySelector: ".order-empty-section",
    contentSelector: "[data-order-content]",
  });

  let allLines: PracticeLine[] = [];
  let roundLines: PracticeLine[] = [];
  let currentOrder: PracticeLine[] = [];
  let roundComplete = false;

  const linesContainer = document.querySelector("[data-order-lines]");
  const checkButton = document.querySelector("[data-check-order]");

  if (
    script &&
    linesContainer instanceof HTMLElement &&
    checkButton instanceof HTMLButtonElement
  ) {
    allLines = getAllLines(script);
    checkButton.addEventListener("click", handlePrimaryAction);

    startRound();
  }

  function startRound(): void {
    if (!script) {
      showToast(
        "Select at least one practice character with dialogue in the selected scenes.",
        "error",
      );
      if (checkButton instanceof HTMLButtonElement) {
        checkButton.disabled = true;
      }
      return;
    }

    roundLines = getOrderWindow(script);
    if (roundLines.length < 2) {
      showToast(
        "This script needs at least two dialogue lines in a valid window.",
        "error",
      );
      return;
    }

    currentOrder = shuffle(roundLines);
    roundComplete = false;

    if (checkButton instanceof HTMLButtonElement) {
      checkButton.disabled = false;
      checkButton.textContent = "Check";
    }
    renderLines();
  }

  function getOrderWindow(activeScript: NonNullable<typeof script>): PracticeLine[] {
    const settings = getPracticeSettings(activeScript);
    const sceneLines = new Map<string, PracticeLine[]>();

    for (const practiceLine of allLines) {
      const sceneKey = getSceneKey(
        practiceLine.actIndex,
        practiceLine.sceneIndex,
      );
      if (
        settings.scenes.includes(sceneKey) &&
        practiceLine.line.type === "line" &&
        practiceLine.line.text?.trim()
      ) {
        const lines = sceneLines.get(sceneKey) || [];
        lines.push(practiceLine);
        sceneLines.set(sceneKey, lines);
      }
    }

    const candidateWindows: PracticeLine[][] = [];
    for (const lines of sceneLines.values()) {
      const size = Math.min(5, lines.length);
      for (let start = 0; start <= lines.length - size; start += 1) {
        const window = lines.slice(start, start + size);
        if (
          window.some((practiceLine) =>
            practiceLine.line.characters?.some((character) =>
              settings.characters.includes(character),
            ),
          )
        ) {
          candidateWindows.push(window);
        }
      }
    }

    if (candidateWindows.length === 0) {
      return [];
    }

    return candidateWindows[
      Math.floor(Math.random() * candidateWindows.length)
    ];
  }

  function renderLines(): void {
    if (!(linesContainer instanceof HTMLElement)) {
      return;
    }

    linesContainer.replaceChildren(
      ...currentOrder.map((practiceLine, index) => {
        const item = document.createElement("div");
        item.className = "order-line";

        const text = document.createElement("p");
        text.className = "order-line-text";
        text.textContent = practiceLine.line.text || "";

        const character = document.createElement("span");
        character.className = "order-line-character";
        character.textContent =
          practiceLine.line.characters?.join(" / ") || "Unknown character";

        const controls = document.createElement("div");
        controls.className = "order-line-controls";
        controls.append(
          createMoveButton("↑", `Move line ${index + 1} up`, () =>
            moveLine(index, -1),
          ),
          createMoveButton("↓", `Move line ${index + 1} down`, () =>
            moveLine(index, 1),
          ),
        );

        item.append(character, text, controls);
        return item;
      }),
    );
  }

  function moveLine(index: number, offset: number): void {
    const targetIndex = index + offset;
    if (
      roundComplete ||
      targetIndex < 0 ||
      targetIndex >= currentOrder.length
    ) {
      return;
    }

    [currentOrder[index], currentOrder[targetIndex]] = [
      currentOrder[targetIndex],
      currentOrder[index],
    ];
    renderLines();
  }

  function checkOrder(): void {
    const isCorrect = currentOrder.every((line, index) =>
      sameLine(line, roundLines[index]),
    );

    if (!isCorrect) {
      showToast("Not quite. Keep adjusting the lines and try again.", "error");
      return;
    }

    roundComplete = true;
    showToast("Correct order!");
    if (checkButton instanceof HTMLButtonElement) {
      checkButton.textContent = "Next";
    }
    renderLines();
  }

  function handlePrimaryAction(): void {
    if (roundComplete) {
      startRound();
      return;
    }

    checkOrder();
  }

  function createMoveButton(
    label: string,
    accessibleLabel: string,
    onClick: () => void,
  ): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "button-secondary order-line-button";
    button.textContent = label;
    button.setAttribute("aria-label", accessibleLabel);
    button.addEventListener("click", onClick);
    return button;
  }

  function sameLine(first: PracticeLine, second: PracticeLine): boolean {
    return (
      first.actIndex === second.actIndex &&
      first.sceneIndex === second.sceneIndex &&
      first.lineIndex === second.lineIndex
    );
  }

  function shuffle(lines: PracticeLine[]): PracticeLine[] {
    const shuffled = [...lines];
    for (let index = shuffled.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [shuffled[index], shuffled[randomIndex]] = [
        shuffled[randomIndex],
        shuffled[index],
      ];
    }
    return shuffled;
  }

</script>

<style is:global>
  .order-content[hidden],
  .order-empty-section[hidden] {
    display: none;
  }

  .order-content {
    display: grid;
    gap: var(--space-4);
  }

  .order-lines {
    display: grid;
    gap: var(--space-2);
  }

  .order-line {
    display: grid;
    grid-template-columns: minmax(8rem, 0.3fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--app-border);
    border-radius: var(--radius-small);
    background: var(--app-surface-raised);
  }

  .order-line-character {
    color: var(--gold-light);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .order-line-text {
    margin: 0;
  }

  .order-line-controls {
    display: flex;
    gap: var(--space-1);
  }

  .order-line-button {
    min-width: 2.5rem;
    padding: 0.55rem 0.7rem;
    font-size: 1.1rem;
    line-height: 1;
  }

  .order-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  @media (max-width: 700px) {
    .order-line {
      grid-template-columns: 1fr auto;
    }

    .order-line-character,
    .order-line-text {
      grid-column: 1;
    }

    .order-line-controls {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
