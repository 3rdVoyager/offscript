---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import EmptyState from '../../../components/EmptyState.astro';
---

<AppLayout pageTitle="Reveal">
  <AppSection class="app-page-header">
    <h1>Reveal</h1>
    <p>Hide lines and reveal them when you need a prompt.</p>
  </AppSection>

  <AppSection>
    <AppSection variant="card">
      <EmptyState
        title="Reveal practice coming soon"
        description="Add a script and choose your practice settings to begin."
      />
    </AppSection>
  </AppSection>
</AppLayout>
