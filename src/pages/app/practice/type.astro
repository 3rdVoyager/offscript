---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import EmptyState from '../../../components/EmptyState.astro';
---

<AppLayout pageTitle="Type">
  <AppSection class="app-page-header">
    <h1>Type</h1>
    <p>Type each line from memory and check your answer as you practice.</p>
  </AppSection>

  <AppSection>
    <AppSection variant="card">
      <EmptyState
        title="Type practice coming soon"
        description="Add a script and choose your practice settings to begin."
      />
    </AppSection>
  </AppSection>
</AppLayout>
