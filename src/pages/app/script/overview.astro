---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import EmptyState from '../../../components/EmptyState.astro';
---

<AppLayout pageTitle="Overview">
  <AppSection class="app-page-header">
    <h1>Overview</h1>
    <p>See the characters, scenes, and structure of your active script.</p>
  </AppSection>

  <AppSection>
    <AppSection variant="card">
      <EmptyState
        title="Overview coming soon"
        description="This page will show the structure of your selected script."
      />
    </AppSection>
  </AppSection>
</AppLayout>
