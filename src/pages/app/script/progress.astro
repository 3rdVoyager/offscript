---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import AppPageHeader from '../../../components/AppPageHeader.astro';
import EmptyState from '../../../components/EmptyState.astro';
import ProgressMeter from '../../../components/ProgressMeter.astro';
import '../../../styles/progress.css';
---

<AppLayout pageTitle="Progress">
  <AppPageHeader
    title="Progress"
    description="Track how much of your active script you have mastered."
  />

  <AppSection class="progress-empty-section" ariaLabel="Progress empty state">
    <AppSection variant="card">
      <EmptyState
        title="No script selected"
        description="Select a script to see your line progress."
        actionLabel="Choose a script"
        actionHref="/app/manage/scripts/"
      />
    </AppSection>
  </AppSection>

  <div class="progress-content" data-progress-content hidden>
    <AppSection variant="card" class="progress-summary" ariaLabel="Overall progress">
      <div>
        <p class="progress-label">Overall progress</p>
        <strong class="progress-value" data-progress-value>0%</strong>
        <p data-progress-detail></p>
      </div>
      <ProgressMeter class="progress-meter-large" ariaLabel="Overall progress" />
    </AppSection>

    <AppSection variant="card" ariaLabel="Progress by act">
      <h2>Progress by act</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Act</th>
              <th scope="col">Progress</th>
              <th scope="col">Completed</th>
              <th scope="col">Lines</th>
            </tr>
          </thead>
          <tbody data-progress-acts></tbody>
        </table>
      </div>
    </AppSection>
  </div>
</AppLayout>

<script>
  import { initializeActiveScriptPage } from '../../../scripts/active-script-page';
  import { getProgressSummary } from '../../../scripts/progress';

  initializeActiveScriptPage({
    emptySelector: '.progress-empty-section',
    contentSelector: '[data-progress-content]',
    render: renderProgress,
  });

  function renderProgress(script: Parameters<typeof getProgressSummary>[0]): void {
    const summary = getProgressSummary(script);
    setText('[data-progress-value]', `${summary.progress}%`);
    setText(
      '[data-progress-detail]',
      `${summary.completed} of ${summary.lines} lines completed`,
    );

    const progressBar = document.querySelector('[data-progress-meter-bar]');
    if (progressBar instanceof HTMLElement) {
      progressBar.style.width = `${summary.progress}%`;
    }

    const acts = document.querySelector('[data-progress-acts]');
    if (acts) {
      acts.replaceChildren(...summary.acts.map(createActRow));
    }
  }

  function createActRow(act: {
    title: string;
    progress: number;
    completed: number;
    lines: number;
  }): HTMLTableRowElement {
    const row = document.createElement('tr');
    row.innerHTML = '<th scope="row"></th><td></td><td></td><td></td>';
    row.cells[0].textContent = act.title;
    row.cells[1].innerHTML =
      '<div class="progress-table-cell"><div class="progress-meter"><span class="progress-meter-bar"></span></div><strong></strong></div>';
    const bar = row.cells[1].querySelector('.progress-meter-bar');
    if (bar instanceof HTMLElement) {
      bar.style.width = `${act.progress}%`;
    }
    const value = row.cells[1].querySelector('strong');
    if (value) {
      value.textContent = `${act.progress}%`;
    }
    row.cells[2].textContent = `${act.completed}`;
    row.cells[3].textContent = `${act.lines}`;
    return row;
  }

  function setText(selector: string, value: string): void {
    const element = document.querySelector(selector);
    if (element) {
      element.textContent = value;
    }
  }
</script>
