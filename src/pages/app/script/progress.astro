---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import EmptyState from '../../../components/EmptyState.astro';
---

<AppLayout pageTitle="Progress">
  <AppSection class="app-page-header">
    <h1>Progress</h1>
    <p>Track the lines and scenes you have mastered.</p>
  </AppSection>

  <AppSection>
    <AppSection variant="card">
      <EmptyState
        title="Progress coming soon"
        description="Your practice history and mastery breakdown will appear here."
      />
    </AppSection>
  </AppSection>
</AppLayout>
