---
import AppLayout from '../../../layouts/AppLayout.astro';
import AppSection from '../../../components/AppSection.astro';
import AppPageHeader from '../../../components/AppPageHeader.astro';
import EmptyState from '../../../components/EmptyState.astro';
import '../../../styles/script-view.css';
---

<AppLayout pageTitle="View">
  <AppPageHeader
    title="View"
    description="Read the complete text of your active script."
  />

  <AppSection class="script-view-empty-section" ariaLabel="Script view empty state">
    <AppSection variant="card">
      <EmptyState
        title="No script selected"
        description="Select a script to read it here."
        actionLabel="Choose a script"
        actionHref="/app/manage/scripts/"
      />
    </AppSection>
  </AppSection>

  <div class="script-view-content" data-script-view hidden>
    <AppSection variant="card" class="script-view-header" ariaLabel="Script title">
      <p class="overview-label">Active script</p>
      <h2 data-script-title></h2>
      <p data-script-notes></p>
    </AppSection>

    <AppSection variant="card" class="script-document" ariaLabel="Complete script">
      <div data-script-document></div>
    </AppSection>
  </div>
</AppLayout>

<script>
  import { getActiveScript } from '../../../scripts/script-store';

  interface ScriptLine {
    type?: string;
    text?: string;
    characters?: string[];
  }

  interface ScriptScene {
    title?: string;
    lines?: ScriptLine[];
  }

  interface ScriptAct {
    title?: string;
    scenes?: ScriptScene[];
  }

  interface Script {
    title?: string;
    notes?: string;
    acts?: ScriptAct[];
  }

  const emptySection = document.querySelector('.script-view-empty-section');
  const viewContent = document.querySelector('[data-script-view]');

  if (emptySection instanceof HTMLElement && viewContent instanceof HTMLElement) {
    const script = getActiveScript();

    if (script) {
      emptySection.hidden = true;
      viewContent.hidden = false;
      renderScript(script);
    }
  }

  function renderScript(script: Script): void {
    setText('[data-script-title]', script.title || 'Untitled script');
    setText('[data-script-notes]', script.notes || 'No notes added for this script.');

    const documentElement = document.querySelector('[data-script-document]');
    if (!(documentElement instanceof HTMLElement)) {
      return;
    }

    const acts = Array.isArray(script.acts) ? script.acts : [];
    documentElement.replaceChildren(...acts.map((act, actIndex) => createAct(act, actIndex)));
  }

  function createAct(act: ScriptAct, actIndex: number): HTMLElement {
    const element = document.createElement('section');
    element.className = 'script-view-act';

    const heading = document.createElement('h2');
    heading.textContent = act.title || `Act ${actIndex + 1}`;
    element.append(heading);

    const scenes = Array.isArray(act.scenes) ? act.scenes : [];
    element.append(...scenes.map((scene, sceneIndex) => createScene(scene, sceneIndex)));

    return element;
  }

  function createScene(scene: ScriptScene, sceneIndex: number): HTMLElement {
    const element = document.createElement('section');
    element.className = 'script-view-scene';

    const heading = document.createElement('h3');
    heading.textContent = scene.title || `Scene ${sceneIndex + 1}`;
    element.append(heading);

    const lines = Array.isArray(scene.lines) ? scene.lines : [];
    element.append(...lines.map(createLine));
    return element;
  }

  function createLine(line: ScriptLine): HTMLElement {
    if (line.type === 'direction') {
      const direction = document.createElement('p');
      direction.className = 'script-view-direction';
      direction.textContent = line.text || '';
      return direction;
    }

    const dialogue = document.createElement('div');
    dialogue.className = 'script-view-line';

    const speaker = document.createElement('strong');
    speaker.className = 'script-view-speaker';
    speaker.textContent = Array.isArray(line.characters) && line.characters.length > 0
      ? line.characters.join(' / ')
      : 'Unknown';

    const text = document.createElement('p');
    text.textContent = line.text || '';
    dialogue.append(speaker, text);
    return dialogue;
  }

  function setText(selector: string, value: string): void {
    const element = document.querySelector(selector);
    if (element) {
      element.textContent = value;
    }
  }
</script>
