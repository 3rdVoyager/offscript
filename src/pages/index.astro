---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";

const showcases = [
  {
    title: "Import your script",
    description:
      "Upload a JSON file or paste converted script data. Example scripts are included if you want to try the app first.",
    image: "/assets/screenshots/offscript-import.png",
    alt: "Add script screen with upload and paste fields",
  },
  {
    title: "Keep scripts in one place",
    description:
      "Save multiple plays or study documents, select the one you are working on, and jump back in where you left off.",
    image: "/assets/screenshots/offscript-scripts.png",
    alt: "Scripts library with a selected play card",
  },
  {
    title: "See the big picture",
    description:
      "Review acts, scenes, spoken lines, and character counts before you start drilling lines.",
    image: "/assets/screenshots/offscript-overview.png",
    alt: "Script overview with structure and character statistics",
  },
  {
    title: "Practice with Tools",
    description:
      "Work through your lines from memory, check answers, and build recall one line at a time.",
    image: "/assets/screenshots/offscript-type.png",
    alt: "Type practice tool with character prompt and answer field",
  },
  {
    title: "Track your progress",
    description:
      "See overall completion and progress by act so you know what still needs work.",
    image: "/assets/screenshots/offscript-progress.png",
    alt: "Progress page with overall completion and per-act breakdown",
  },
];
---

<SiteLayout pageTitle="From Reading to Remembering">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-layout">
      <div class="hero-inner">
        <p class="hero-eyebrow">For actors, students &amp; readers</p>
        <h1 id="hero-heading">From Reading to <em>Remembering</em></h1>
        <p class="hero-lead">
          OffScript helps you import a script, choose what to practice, and rehearse
          lines in the browser. Your data stays local on your device, no account required.
        </p>
        <div class="hero-actions">
          <a href="/app/" class="button-primary">Get Started</a>
          <a href="#product" class="button-ghost">See the app</a>
        </div>
      </div>
      <figure class="hero-preview">
        <img
          src="/assets/screenshots/offscript-overview.png"
          alt="OffScript overview showing script statistics and structure"
          width="980"
          height="800"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section id="product" class="section showcase" aria-labelledby="product-heading">
    <div class="section-inner">
      <header class="section-header">
        <p class="section-eyebrow">The app</p>
        <h2 id="product-heading">Built for real rehearsal</h2>
        <p class="section-lead">
          Import a script, practice with tools that force recall, and track how much
          you have mastered.
        </p>
      </header>

      <ul class="showcase-list">
        {
          showcases.map((item, index) => (
            <li class:list={["showcase-item", index % 2 === 1 && "showcase-item-reverse"]}>
              <figure class="showcase-shot">
                <img
                  src={item.image}
                  alt={item.alt}
                  width="980"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="showcase-copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section audience" aria-labelledby="audience-heading">
    <div class="section-inner audience-inner">
      <header class="section-header">
        <p class="section-eyebrow">Who it's for</p>
        <h2 id="audience-heading">Made for anyone who performs from memory</h2>
      </header>

      <ul class="audience-grid">
        <li class="audience-card">
          <h3>Actors</h3>
          <p>Get off-book faster for auditions, rehearsals, and opening night.</p>
        </li>
        <li class="audience-card">
          <h3>Students</h3>
          <p>Prepare speeches, presentations, and exams with real recall.</p>
        </li>
        <li class="audience-card">
          <h3>Readers</h3>
          <p>Retain what you read long after you close the book.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="home-cta" class="cta-banner" aria-labelledby="cta-heading">
    <div class="cta-banner-inner">
      <h2 id="cta-heading">Ready to go off script?</h2>
      <p>Start practicing for free. No account required.</p>
      <a href="/app/" class="button-primary">Get Started</a>
    </div>
  </section>
</SiteLayout>
